# Generado por Terraform (output kubernetes_azure): lo propio de Azure. No lo edites a mano.
# El resto de manifiestos (deploy/kubernetes/*.yaml) es igual en todos los entornos.
apiVersion: v1
kind: ConfigMap
metadata: {name: opsagent-entorno, namespace: ${namespace}}
data:
  OTEL_TRACES_BACKEND: "${otel_traces_backend}"
  MCP_ISSUER_URL: "${mcp_issuer_url}"
---
# Key Vault → Secrets de Kubernetes <workload>-secrets (los que leen los Deployments con envFrom).
apiVersion: secrets-store.csi.x-k8s.io/v1
kind: SecretProviderClass
metadata: {name: opsagent-keyvault, namespace: ${namespace}}
spec:
  provider: azure
  parameters:
    usePodIdentity: "false"
    clientID: "${client_id}"
    keyvaultName: "${key_vault}"
    tenantId: "${tenant_id}"
    objects: |
      array:
%{ for workload, secrets in workload_secrets ~}
%{ for name, key in secrets ~}
        - |
          objectName: ${name}
          objectType: secret
%{ endfor ~}
%{ endfor ~}
  secretObjects:
%{ for workload, secrets in workload_secrets ~}
    - secretName: ${workload}-secrets
      type: Opaque
      data:
%{ for name, key in secrets ~}
        - {objectName: ${name}, key: ${key}}
%{ endfor ~}
%{ endfor ~}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${service_account}
  namespace: ${namespace}
  annotations:
    azure.workload.identity/client-id: "${client_id}"
automountServiceAccountToken: false
---
# El driver CSI solo crea y actualiza los Secrets mientras algún pod monta el volumen: este pod
# (pause, sin red ni permisos) existe para eso.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: secrets-sync
  namespace: ${namespace}
  labels: {app.kubernetes.io/name: secrets-sync, app.kubernetes.io/part-of: opsagent}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: secrets-sync}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: secrets-sync
        app.kubernetes.io/part-of: opsagent
        azure.workload.identity/use: "true"
    spec:
      serviceAccountName: ${service_account}
      securityContext:
        runAsNonRoot: true
        runAsUser: 65535
        runAsGroup: 65535
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: pause
          image: registry.k8s.io/pause:3.10
          resources:
            requests: {cpu: 5m, memory: 8Mi}
            limits: {memory: 16Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: keyvault, mountPath: /mnt/secrets-store, readOnly: true}
      volumes:
        - name: keyvault
          csi:
            driver: secrets-store.csi.k8s.io
            readOnly: true
            volumeAttributes: {secretProviderClass: opsagent-keyvault}
